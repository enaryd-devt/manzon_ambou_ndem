<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meeting_available_amount_wizard_form" model="ir.ui.view">
        <field name="name">association.meeting.available.amount.wizard.form</field>
        <field name="model">association.meeting.available.amount.wizard</field>
        <field name="arch" type="xml">
            <form string="Affecter le montant disponible">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="meeting_id"/>
                        <field name="period_id"/>
                    </group>
                    <group string="Trésorerie de séance" col="3">
                        <field name="collected_amount" readonly="1"/>
                        <field name="expense_amount" readonly="1"/>
                        <field name="available_amount" readonly="1" class="fw-bold"/>
                    </group>
                    <div class="alert alert-info">Le montant disponible correspond au total collecté, diminué des dépenses de la séance et des montants déjà affectés.</div>
                    <group string="Décision d’affectation">
                        <field name="destination" widget="radio" options="{'horizontal': true}"/>
                        <field name="beneficiary_id" invisible="destination != 'beneficiary'" required="destination == 'beneficiary'"/>
                        <field name="fund_id" invisible="destination != 'treasury'" required="destination == 'treasury'"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer l’affectation" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
