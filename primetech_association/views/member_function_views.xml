<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================== -->
    <!-- VUE RECHERCHE                                              -->
    <!-- ========================================================== -->

    <record
        id="view_association_member_function_search"
        model="ir.ui.view">

        <field name="name">association.member.function.search</field>

        <field name="model">association.member.function</field>

        <field name="arch" type="xml">

            <search string="Fonctions des membres">

                <field name="name"/>

                <filter
                    name="filter_active"
                    string="Actives"
                    domain="[('active', '=', True)]"/>

                <filter
                    name="filter_archived"
                    string="Archivées"
                    domain="[('active', '=', False)]"/>

                <separator/>

                <group
                    expand="0"
                    string="Regrouper par">

                    <filter
                        name="group_company"
                        string="Filiale"
                        context="{'group_by': 'company_id'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- ========================================================== -->
    <!-- VUE LISTE                                                  -->
    <!-- ========================================================== -->

    <record
        id="view_association_member_function_list"
        model="ir.ui.view">

        <field name="name">association.member.function.list</field>

        <field name="model">association.member.function</field>

        <field name="arch" type="xml">

            <list
                string="Fonctions des membres"
                editable="bottom"
                default_order="sequence, name"
                decoration-muted="not active">

                <field
                    name="sequence"
                    widget="handle"/>

                <field
                    name="name"
                    string="Fonction"/>

                <field
                    name="company_id"
                    string="Filiale"
                    groups="base.group_multi_company"
                    optional="show"/>

                <field
                    name="active"
                    string="Active"
                    widget="boolean_toggle"
                    optional="show"/>

            </list>

        </field>

    </record>


    <!-- ========================================================== -->
    <!-- VUE FORMULAIRE                                             -->
    <!-- ========================================================== -->

    <record
        id="view_association_member_function_form"
        model="ir.ui.view">

        <field name="name">association.member.function.form</field>

        <field name="model">association.member.function</field>

        <field name="arch" type="xml">

            <form string="Fonction de membre">

                <sheet>

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Fonction"/>

                        <h1>

                            <field
                                name="name"
                                placeholder="Ex. Président, Trésorier, Secrétaire..."/>

                        </h1>

                    </div>

                    <group>

                        <group string="Informations">

                            <field
                                name="sequence"
                                string="Ordre"/>

                            <field
                                name="active"
                                widget="boolean_toggle"/>

                        </group>

                        <group string="Organisation">

                            <field
                                name="company_id"
                                string="Filiale"
                                groups="base.group_multi_company"/>

                        </group>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================================================== -->
    <!-- ACTION                                                     -->
    <!-- ========================================================== -->

    <record
        id="action_association_member_function"
        model="ir.actions.act_window">

        <field name="name">Fonctions des membres</field>

        <field name="res_model">association.member.function</field>

        <field name="view_mode">list,form</field>

        <field
            name="search_view_id"
            ref="view_association_member_function_search"/>

        <field name="context">
            {
                'search_default_filter_active': 1
            }
        </field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Créez votre première fonction
            </p>

            <p>
                Les fonctions permettent de définir
                le rôle organisationnel d'un membre.
            </p>

        </field>

    </record>

</odoo>