<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- RECHERCHE                                                 -->
    <!-- ========================================================= -->

    <record id="view_association_member_account_search" model="ir.ui.view">

        <field name="name">association.member.account.search</field>

        <field name="model">association.member.account</field>

        <field name="arch" type="xml">

            <search string="Rechercher un compte membre">

                <field name="name"/>

                <field name="member_id"/>

                <field name="member_code"/>

                <field name="company_id"/>

                <separator/>

                <filter
                    name="filter_active"
                    string="Actifs"
                    domain="[('active', '=', True)]"/>

                <filter
                    name="filter_archived"
                    string="Archivés"
                    domain="[('active', '=', False)]"/>

                <group expand="0" string="Regrouper par">

                    <filter
                        name="group_company"
                        string="Filiale"
                        context="{'group_by': 'company_id'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- LISTE                                                     -->
    <!-- ========================================================= -->

    <record id="view_association_member_account_list" model="ir.ui.view">

        <field name="name">association.member.account.list</field>

        <field name="model">association.member.account</field>

        <field name="arch" type="xml">

            <list
                string="Comptes membres"
                decoration-muted="not active">

                <field name="name"/>

                <field name="member_code"/>

                <field name="member_id"/>

                <field
                    name="total_credit"
                    sum="Total crédité"/>

                <field
                    name="total_debit"
                    sum="Total débité"/>

                <field
                    name="balance"
                    sum="Solde global"/>

                <field name="company_id" groups="base.group_multi_company"/>

                <field name="currency_id" column_invisible="True"/>

                <field name="active" optional="hide"/>

            </list>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- FORMULAIRE                                                -->
    <!-- ========================================================= -->

    <record id="view_association_member_account_form" model="ir.ui.view">

        <field name="name">association.member.account.form</field>

        <field name="model">association.member.account</field>

        <field name="arch" type="xml">

            <form string="Compte membre">

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_transactions"
                            icon="fa-exchange">

                            <field
                                name="transaction_count"
                                widget="statinfo"
                                string="Mouvements"/>

                        </button>

                    </div>

                    <widget
                        name="web_ribbon"
                        title="Archivé"
                        bg_color="text-bg-danger"
                        invisible="active"/>

                    <div class="oe_title">

                        <label for="member_id"/>

                        <h1>

                            <field
                                name="member_id"
                                placeholder="Sélectionner un membre..."/>

                        </h1>

                        <div class="d-flex align-items-center gap-2">

                            <span
                                class="badge rounded-pill text-bg-light border"
                                style="white-space: normal;">

                                <field name="name" readonly="1"/>

                            </span>

                            <span
                                class="badge rounded-pill text-bg-light border"
                                style="white-space: normal;">

                                <field name="member_code"/>

                            </span>

                        </div>

                    </div>

                    <group>

                        <group string="Membre">

                            <field name="member_id"/>

                            <field name="member_code" readonly="1"/>

                            <field name="company_id" readonly="1"/>

                            <field name="active"/>

                        </group>

                        <group string="Situation du compte">

                            <field
                                name="total_credit"
                                readonly="1"/>

                            <field
                                name="total_debit"
                                readonly="1"/>

                            <field
                                name="balance"
                                readonly="1"
                                class="fw-bold"/>

                            <field name="currency_id" readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Mouvements">

                            <field
                                name="transaction_ids"
                                readonly="1">

                                <list
                                    decoration-success="transaction_type == 'credit' and state == 'validated'"
                                    decoration-danger="transaction_type == 'debit' and state == 'validated'"
                                    decoration-muted="state == 'cancelled'">

                                    <field name="transaction_date"/>

                                    <field name="name"/>

                                    <field name="description"/>

                                    <field
                                        name="transaction_type"
                                        widget="badge"
                                        decoration-success="transaction_type == 'credit'"
                                        decoration-danger="transaction_type == 'debit'"/>

                                    <field name="amount"/>

                                    <field name="origin_type"/>

                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-muted="state == 'draft'"
                                        decoration-success="state == 'validated'"
                                        decoration-danger="state == 'cancelled'"/>

                                </list>

                            </field>

                        </page>

                        <page string="Notes internes">

                            <field
                                name="note"
                                placeholder="Notes relatives au compte du membre..."/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION                                                    -->
    <!-- ========================================================= -->

    <record
        id="action_association_member_account"
        model="ir.actions.act_window">

        <field name="name">Comptes membres</field>

        <field name="res_model">association.member.account</field>

        <field name="view_mode">list,form</field>

        <field
            name="search_view_id"
            ref="view_association_member_account_search"/>

        <field
            name="context"
            eval="{'search_default_filter_active': 1}"/>

    </record>

</odoo>