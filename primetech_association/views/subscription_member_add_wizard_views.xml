<odoo>
    <record id="view_subscription_member_add_wizard_form" model="ir.ui.view">
        <field name="name">association.subscription.member.add.wizard.form</field>
        <field name="model">association.subscription.member.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter un membre">
                <sheet>
                    <div class="alert alert-info">Le membre est ajouté à la cotisation en cours. Vous décidez ci-dessous si les cycles déjà terminés deviennent aussi exigibles.</div>
                    <group>
                        <field name="subscription_id"/>
                        <field name="member_id"/>
                        <field name="include_past_periods"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Ajouter le membre" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
