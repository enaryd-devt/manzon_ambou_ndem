<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_fee_list" model="ir.ui.view">
        <field name="name">association.membership.fee.list</field>
        <field name="model">association.membership.fee</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-warning="state == 'due'">
                <field name="member_id"/>
                <field name="fee_type"/>
                <field name="name"/>
                <field name="fund_id"/>
                <field name="amount" sum="Total"/>
                <field name="amount_paid" sum="Réglé"/>
                <field name="amount_remaining" sum="Reste"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_membership_fee_form" model="ir.ui.view">
        <field name="name">association.membership.fee.form</field>
        <field name="model">association.membership.fee</field>
        <field name="arch" type="xml">
            <form string="Créance membre">
                <header>
                    <button name="action_validate_adjustment" type="object" string="Valider l'ajustement"
                        class="oe_highlight" invisible="fee_type != 'adjustment' or state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,due,paid,cancelled" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. Régularisation de cotisation" readonly="fee_type == 'adjustment' and state != 'draft'"/></h1>
                        <div class="text-muted" invisible="fee_type != 'adjustment'">
                            Cet ajustement augmente le montant dû par le membre et sera encaissé en dernière priorité.
                        </div>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="fee_type" readonly="fee_type == 'adjustment' and state != 'draft'"/>
                            <field name="member_id" readonly="fee_type == 'adjustment' and state != 'draft'"/>
                            <field name="fund_id" readonly="fee_type == 'adjustment' and state != 'draft'"/>
                        </group>
                        <group string="Situation financière">
                            <field name="amount" readonly="fee_type == 'adjustment' and state != 'draft'"/>
                            <field name="amount_paid"/>
                            <field name="amount_remaining"/>
                        </group>
                    </group>
                    <div class="alert alert-info" invisible="fee_type != 'adjustment' or state != 'draft'" role="alert">
                        Vérifiez le membre, le montant et le compte de trésorerie avant validation. Ces informations seront verrouillées ensuite.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_membership_fee_search" model="ir.ui.view">
        <field name="name">association.membership.fee.search</field>
        <field name="model">association.membership.fee</field>
        <field name="arch" type="xml"><search><field name="member_id"/><field name="fee_type"/><field name="fund_id"/><filter string="À régler" name="due" domain="[('state','=','due')]"/><filter string="Réglés" name="paid" domain="[('state','=','paid')]"/></search></field>
    </record>
    <record id="action_membership_fee" model="ir.actions.act_window">
        <field name="name">Frais d’adhésion</field><field name="res_model">association.membership.fee</field><field name="view_mode">list,form</field><field name="domain">[('fee_type','=','membership')]</field><field name="context">{'default_fee_type': 'membership'}</field><field name="search_view_id" ref="view_membership_fee_search"/>
    </record>
    <record id="action_member_situation_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustements de situation</field><field name="res_model">association.membership.fee</field><field name="view_mode">list,form</field><field name="domain">[('fee_type','=','adjustment')]</field><field name="context">{'default_fee_type': 'adjustment', 'default_state': 'draft'}</field><field name="search_view_id" ref="view_membership_fee_search"/>
    </record>
</odoo>
