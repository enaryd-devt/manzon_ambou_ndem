<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record
        id="view_association_meeting_allocation_form"
        model="ir.ui.view">

        <field name="name">
            association.subscription.allocation.form
        </field>

        <field name="model">
            association.subscription.allocation
        </field>

        <field name="priority">1</field>

        <field name="arch" type="xml">

            <form string="Attribuer la cagnotte">

                <sheet>

                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="subscription_id" invisible="1"/>
                    <field name="state" invisible="1"/>

                    <group>

                        <group>

                            <field
                                name="period_id"
                                string="Cycle"
                                readonly="1"
                                options="{'no_create': True, 'no_open': True}"
                            />

                            <field
                                name="meeting_id"
                                string="Réunion"
                                readonly="1"
                                options="{'no_create': True, 'no_open': True}"
                            />

                            <field
                                name="allocation_date"
                                string="Date d'attribution"
                            />

                        </group>

                        <group>

                            <field
                                name="beneficiary_id"
                                string="Bénéficiaire"
                                options="{'no_create': True, 'no_open': True}"
                            />

                            <field
                                name="amount"
                                string="Montant attribué"
                            />

                            <field
                                name="allocation_method"
                                string="Mode d'attribution"
                            />

                        </group>

                    </group>

                    <group string="Décision / Observation">

                        <field
                            name="decision_note"
                            nolabel="1"
                            placeholder="Décision prise pendant la réunion..."
                        />

                    </group>

                </sheet>

            </form>

        </field>

    </record>

</odoo>