<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Association roles are rendered explicitly: unlike Odoo's generated
         group checkboxes, this block remains available without debug mode. -->
    <record id="view_users_form_association_access" model="ir.ui.view">
        <field name="name">res.users.form.association.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Association Management" groups="base.group_system">
                    <group>
                        <field name="association_access_level" widget="radio"/>
                    </group>
                    <group string="Compte membre" invisible="association_access_level != 'member'">
                        <field name="association_member_id" domain="[('user_id', 'in', [False, id])]" required="association_access_level == 'member'"/>
                    </group>
                    <group string="Fonctions de réunion">
                        <field name="association_meeting_president"/>
                        <field name="association_meeting_secretary"/>
                        <field name="association_meeting_vice_president"/>
                        <field name="association_meeting_vice_secretary"/>
                        <field name="association_accountant"/>
                        <field name="association_meeting_treasurer"/>
                        <field name="association_meeting_censor"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
