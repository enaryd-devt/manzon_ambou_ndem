<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo hides categories with several independent groups from the normal
        generated access-rights view.  Association roles are intentionally
        independent (president, secretary, treasurer and censor), so expose
        this category explicitly to Settings administrators without requiring
        developer mode.
    -->
    <record id="view_users_form_association_access" model="ir.ui.view">
        <field name="name">res.users.form.association.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Association Management" groups="base.group_system">
                    <div class="text-muted" colspan="2">
                        Sélectionnez le niveau d’accès et, si nécessaire, les fonctions de réunion.
                    </div>
                    <field name="groups_id"
                           widget="many2many_checkboxes"
                           domain="[('category_id', '=', ref('primetech_association.module_category_association'))]"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
