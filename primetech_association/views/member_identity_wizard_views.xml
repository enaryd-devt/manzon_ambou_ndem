<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_member_identity_wizard_form" model="ir.ui.view">
        <field name="name">association.member.identity.wizard.form</field>
        <field name="model">association.member.identity.wizard</field>
        <field name="arch" type="xml">
            <form string="Nom et compte utilisateur">
                <group>
                    <field name="member_id" options="{'no_open': True}"/>
                </group>
                <group string="Identité">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="full_name" readonly="1"/>
                </group>
                <group string="Espace membre">
                    <field name="user_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Enregistrer" class="btn-primary" icon="fa-check"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
