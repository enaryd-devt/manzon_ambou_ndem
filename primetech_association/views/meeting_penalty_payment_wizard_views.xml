<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_meeting_penalty_payment_wizard_form" model="ir.ui.view">
        <field name="name">association.meeting.penalty.payment.wizard.form</field>
        <field name="model">association.meeting.penalty.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Encaisser une sanction financière">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="meeting_id"/>
                            <field name="member_id"/>
                            <field name="penalty_id"/>
                        </group>
                        <group string="Encaissement à la table">
                            <field name="amount_remaining" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_received" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="payment_method"/>
                            <field name="payment_reference"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Ce règlement est ajouté à la caisse temporaire de la séance et sera pris en compte dans le montant disponible à la table.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Encaisser" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
