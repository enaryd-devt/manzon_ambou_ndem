<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_association_meeting_receipt_wizard_form" model="ir.ui.view">
    <field name="name">association.meeting.receipt.wizard.form</field>
    <field name="model">association.meeting.receipt.wizard</field>
    <field name="arch" type="xml">
      <form string="Recette de séance">
        <sheet>
          <field name="company_id" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <div class="alert alert-info" role="alert">Cette recette alimente la caisse temporaire de la séance. Elle sera incluse dans le versement consolidé de fin de réunion.</div>
          <group>
            <group>
              <field name="meeting_id"/>
              <field name="contributor_type" widget="radio" options="{'horizontal': true}"/>
              <field name="member_id" invisible="contributor_type != 'member'" required="contributor_type == 'member'"/>
              <field name="contributor_name" invisible="contributor_type != 'external'" required="contributor_type == 'external'"/>
            </group>
            <group>
              <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
              <field name="payment_method"/>
            </group>
          </group>
          <group>
            <field name="reason" placeholder="Décrivez librement la raison de cette recette..."/>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" type="object" string="Valider la recette" class="btn-primary"/>
          <button string="Annuler" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
