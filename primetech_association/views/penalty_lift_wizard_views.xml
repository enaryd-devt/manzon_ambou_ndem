<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_association_penalty_lift_wizard_form" model="ir.ui.view">
        <field name="name">association.penalty.lift.wizard.form</field>
        <field name="model">association.penalty.lift.wizard</field>
        <field name="arch" type="xml">
            <form string="Lever la sanction">
                <group>
                    <field name="penalty_id"/>
                    <field name="member_id"/>
                    <field name="reason" placeholder="Motif obligatoire de la levée..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer la levée" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
