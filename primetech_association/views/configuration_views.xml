<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <menuitem
        id="menu_configuration_root"
        name="Configuration"
        parent="menu_association_root"
        sequence="900"
        groups="primetech_association.group_association_admin"/>

    <menuitem
        id="menu_association_settings"
        name="Paramètres"
        parent="menu_configuration_root"
        action="action_association_settings"
        sequence="10"/>

    <record id="view_association_access_rights_list" model="ir.ui.view">
        <field name="name">association.access.rights.list</field>
        <field name="model">ir.model.access</field>
        <field name="arch" type="xml">
            <list string="Droits d'acces" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="model_id"/>
                <field name="group_id"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
                <field name="perm_create"/>
                <field name="perm_unlink"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_association_access_rights" model="ir.actions.act_window">
        <field name="name">Droits d'acces</field>
        <field name="res_model">ir.model.access</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_association_access_rights_list"/>
        <field name="domain">[('model_id.model', '=like', 'association.%')]</field>
    </record>

    <menuitem
        id="menu_association_access_rights"
        name="Droits d'acces"
        parent="menu_configuration_root"
        action="action_association_access_rights"
        sequence="20"/>

</odoo>
