<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_meeting_subscription_session" model="ir.actions.report">
        <field name="name">Rapport de clôture de cotisation</field>
        <field name="model">association.meeting.subscription.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_association.report_meeting_subscription_session_document</field>
        <field name="report_file">primetech_association.report_meeting_subscription_session_document</field>
        <field name="binding_model_id" ref="model_association_meeting_subscription_session"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Clôture cotisation - %s' % (object.period_id.name or '')</field>
    </record>
    <template id="report_meeting_subscription_session_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-call="web.external_layout">
                    <div class="page" style="margin-top: 0; padding-top: 0;">
                        <style>
                            .subscription-report-header { border-bottom: 1px solid #d9dde3; margin: 0 0 13px; padding-bottom: 7px; }
                            .subscription-report-title { color: #1f4e78; font-size: 22px; font-weight: 700; margin: 0; }
                            .subscription-report-subtitle { color: #6c757d; font-size: 11px; margin: 4px 0 0; }
                            .subscription-report-published { color: #52616b; float: right; font-size: 9px; margin: 0 0 3px; text-align: right; }
                            .subscription-report-section { color: #1f4e78; font-size: 14px; font-weight: 700; margin: 20px 0 8px; }
                            .subscription-report-summary { margin: 0 -5px 16px; }
                            .subscription-report-summary td { border: 1px solid #d9e2f3; padding: 8px 10px; }
                            .subscription-report-summary .label { color: #52616b; display: block; font-size: 9px; text-transform: uppercase; }
                            .subscription-report-summary .value { color: #1f4e78; display: block; font-size: 15px; font-weight: 700; margin-top: 3px; }
                            .subscription-report-summary .settled { background: #edf8f1; border-color: #a8d9b7; }
                            .subscription-report-summary .settled .label, .subscription-report-summary .settled .value { color: #19733b; }
                            .subscription-report-summary .partial { background: #fff7e7; border-color: #efcf8f; }
                            .subscription-report-summary .partial .label, .subscription-report-summary .partial .value { color: #a45b00; }
                            .subscription-report-table { font-size: 10px; width: 100%; }
                            .subscription-report-table th { background: #1f4e78; color: #fff; font-weight: 700; padding: 7px 5px; }
                            .subscription-report-table td { border-bottom: 1px solid #d9e2f3; padding: 6px 5px; vertical-align: top; }
                            .subscription-report-table .amount { text-align: right; white-space: nowrap; }
                            .subscription-report-empty { border: 1px dashed #adb5bd; color: #6c757d; font-style: italic; padding: 10px; }
                            .subscription-report-note { background: #f4f8fc; border-left: 3px solid #1f4e78; padding: 10px; white-space: pre-line; }
                        </style>
                        <div class="subscription-report-header">
                            <div class="subscription-report-published">Publié le : <t t-if="session.report_published_at"><span t-field="session.report_published_at" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/></t><t t-else=""><span t-field="session.closed_at" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/></t></div>
                            <h2 class="subscription-report-title">Rapport de clôture de cotisation</h2>
                            <p class="subscription-report-subtitle">Synthèse des encaissements de la réunion et de la situation globale des membres.</p>
                        </div>
                        <table class="table table-borderless" style="font-size: 11px; margin-bottom: 12px;">
                            <tr>
                                <td><strong>Réunion :</strong> <span t-field="session.meeting_id"/></td>
                                <td><strong>Cycle :</strong> <span t-field="session.period_id"/></td>
                            </tr>
                            <tr>
                                <td><strong>Cotisation :</strong> <span t-field="session.subscription_id"/></td>
                                <td><strong>Clôturée par :</strong> <span t-field="session.closed_by_id"/></td>
                            </tr>
                        </table>
                        <!-- Situation globale de chaque membre (toutes ses créances),
                             identique au tableau de l'onglet Trésorerie de la réunion. -->
                        <t t-set="situations" t-value="session.meeting_id.treasury_member_situation_ids.sorted(lambda item: item.member_id.display_name or '')"/>
                        <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': session.currency_id}"/>
                        <table class="subscription-report-summary">
                            <tr>
                                <td><span class="label">Encaissé en séance</span><span class="value" t-esc="sum(situations.mapped('amount_paid_in_meeting'))" t-options="money"/></td>
                                <td><span class="label">Reste dû (situation globale)</span><span class="value" t-esc="sum(situations.mapped('amount_due'))" t-options="money"/></td>
                                <td><span class="label">Membres réglés</span><span class="value" t-esc="len(situations.filtered(lambda item: item.payment_state == 'paid'))"/></td>
                                <td><span class="label">Date de clôture</span><span class="value" t-field="session.closed_at" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/></td>
                            </tr>
                        </table>
                        <div class="subscription-report-note" style="margin: -7px 0 16px;">
                            <strong>Compte de trésorerie de versement :</strong>
                            <span t-esc="session.meeting_id.pot_settlement_fund_id.display_name or 'Aucun versement final en trésorerie'"/>
                            <t t-if="session.meeting_id.pot_settlement_transaction_id">
                                — mouvement <span t-esc="session.meeting_id.pot_settlement_transaction_id.name"/>
                            </t>
                        </div>
                        <table class="subscription-report-summary">
                            <tr>
                                <td><span class="label">Membres appelés</span><span class="value" t-esc="len(situations)"/></td>
                                <td class="settled"><span class="label">Totalement réglés</span><span class="value" t-esc="len(situations.filtered(lambda item: item.payment_state == 'paid'))"/></td>
                                <td class="partial"><span class="label">Partiellement réglés</span><span class="value" t-esc="len(situations.filtered(lambda item: item.payment_state == 'partial'))"/></td>
                                <td><span class="label">Non réglés</span><span class="value" t-esc="len(situations.filtered(lambda item: item.payment_state == 'not_paid'))"/></td>
                                <td><span class="label">Encaissements validés</span><span class="value" t-esc="len(situations.filtered(lambda item: item.payment_state in ('paid', 'partial')))"/></td>
                            </tr>
                        </table>
                        <table class="subscription-report-summary">
                            <tr>
                                <td><span class="label">Montant attribué</span><span class="value" t-field="session.closed_allocated_amount"/></td>
                                <td><span class="label">Versé en trésorerie</span><span class="value" t-field="session.period_id.settled_amount"/></td>
                                <td><span class="label">Bénéficiaires</span><span class="value" t-esc="len(session.allocation_ids)"/></td>
                                <td><span class="label">En attente à la clôture</span><span class="value" t-field="session.closed_pending_count"/></td>
                            </tr>
                        </table>

                        <t t-set="meeting_payments" t-value="session.get_meeting_payments()"/>
                        <h3 class="subscription-report-section">Détail des encaissements validés</h3>
                        <table class="subscription-report-table">
                            <thead><tr><th>N° paiement</th><th>Date</th><th>Membre</th><th>Mode</th><th>Référence</th><th class="amount">Montant</th></tr></thead>
                            <tbody>
                                <tr t-foreach="meeting_payments" t-as="payment">
                                    <td><span t-field="payment.name"/></td><td><span t-field="payment.payment_date"/></td><td><span t-field="payment.member_id"/></td><td><span t-field="payment.payment_method"/></td><td><span t-field="payment.payment_reference"/></td><td class="amount"><span t-field="payment.amount"/></td>
                                </tr>
                                <tr t-if="not meeting_payments"><td colspan="6" class="subscription-report-empty">Aucun encaissement validé pour cette réunion.</td></tr>
                            </tbody>
                            <tfoot><tr><td colspan="5" style="text-align: right; font-weight: 700;">Total des encaissements validés</td><td class="amount" style="font-weight: 700;"><span t-field="session.payment_total"/></td></tr></tfoot>
                        </table>

                        <!-- Les recettes et dépenses propres à la séance sont
                             séparées des cotisations pour une lecture transparente. -->
                        <t t-set="meeting_receipts" t-value="session.meeting_id.meeting_receipt_ids.filtered(lambda item: item.state == 'confirmed')"/>
                        <t t-set="meeting_expenses" t-value="session.meeting_id.expense_ids.filtered(lambda item: item.state == 'validated')"/>
                        <t t-set="meeting_receipt_total" t-value="sum(meeting_receipts.mapped('amount'))"/>
                        <t t-set="meeting_expense_total" t-value="sum(meeting_expenses.mapped('amount'))"/>
                        <h3 class="subscription-report-section">Recettes et dépenses de la réunion</h3>
                        <table class="subscription-report-summary">
                            <tr>
                                <td><span class="label">Recettes de séance</span><span class="value" t-esc="meeting_receipt_total" t-options="money"/></td>
                                <td><span class="label">Dépenses de séance</span><span class="value" t-esc="meeting_expense_total" t-options="money"/></td>
                                <td><span class="label">Solde net de séance</span><span class="value" t-esc="meeting_receipt_total - meeting_expense_total" t-options="money"/></td>
                                <td><span class="label">Opérations validées</span><span class="value" t-esc="len(meeting_receipts) + len(meeting_expenses)"/></td>
                            </tr>
                        </table>

                        <h4 style="color: #28784b; font-size: 12px; margin: 12px 0 6px;">Détail des recettes de séance</h4>
                        <table class="subscription-report-table">
                            <thead><tr><th>Date</th><th>Contributeur</th><th>Motif</th><th>Mode</th><th>État</th><th class="amount">Montant</th></tr></thead>
                            <tbody>
                                <tr t-foreach="meeting_receipts" t-as="receipt">
                                    <td><span t-field="receipt.receipt_date"/></td>
                                    <td><span t-field="receipt.contributor_display"/></td>
                                    <td><span t-field="receipt.reason"/></td>
                                    <td><span t-field="receipt.payment_method"/></td>
                                    <td><span t-field="receipt.state"/></td>
                                    <td class="amount"><span t-field="receipt.amount"/></td>
                                </tr>
                                <tr t-if="not meeting_receipts"><td colspan="6" class="subscription-report-empty">Aucune recette de séance confirmée.</td></tr>
                            </tbody>
                            <tfoot><tr><td colspan="5" style="text-align: right; font-weight: 700;">Total des recettes de séance</td><td class="amount" style="font-weight: 700;"><span t-esc="meeting_receipt_total" t-options="money"/></td></tr></tfoot>
                        </table>

                        <h4 style="color: #a13838; font-size: 12px; margin: 16px 0 6px;">Détail des dépenses de séance</h4>
                        <table class="subscription-report-table">
                            <thead><tr><th>Date</th><th>Référence</th><th>Objet</th><th>Bénéficiaire</th><th>Mode</th><th>Justificatif</th><th class="amount">Montant</th></tr></thead>
                            <tbody>
                                <tr t-foreach="meeting_expenses" t-as="expense">
                                    <td><span t-field="expense.expense_date"/></td>
                                    <td><span t-esc="expense.name or expense.external_reference or '—'"/></td>
                                    <td><span t-field="expense.subject"/><t t-if="expense.description"> — <span t-field="expense.description"/></t></td>
                                    <td><span t-esc="expense.member_id.display_name or expense.beneficiary_name or '—'"/></td>
                                    <td><span t-field="expense.payment_method"/></td>
                                    <td><span t-esc="expense.receipt_number or expense.external_reference or '—'"/></td>
                                    <td class="amount"><span t-field="expense.amount"/></td>
                                </tr>
                                <tr t-if="not meeting_expenses"><td colspan="7" class="subscription-report-empty">Aucune dépense de séance validée.</td></tr>
                            </tbody>
                            <tfoot><tr><td colspan="6" style="text-align: right; font-weight: 700;">Total des dépenses de séance</td><td class="amount" style="font-weight: 700;"><span t-esc="meeting_expense_total" t-options="money"/></td></tr></tfoot>
                        </table>

                        <h3 class="subscription-report-section">Attributions et versement</h3>
                        <table class="subscription-report-table">
                            <thead><tr><th>Bénéficiaire</th><th>Mode</th><th>Date</th><th>Statut</th><th class="amount">Montant attribué</th></tr></thead>
                            <tbody>
                                <tr t-foreach="session.allocation_ids" t-as="allocation"><td><span t-field="allocation.beneficiary_id"/></td><td><span t-field="allocation.allocation_method"/></td><td><span t-field="allocation.allocation_date"/></td><td><span t-field="allocation.state"/></td><td class="amount"><span t-field="allocation.amount"/></td></tr>
                                <tr t-if="not session.allocation_ids"><td colspan="5" class="subscription-report-empty">Aucune attribution pour cette session.</td></tr>
                            </tbody>
                            <tfoot><tr><td colspan="3" style="text-align: right; font-weight: 700;">Reliquat versé en trésorerie</td><td style="font-weight: 700;"><span t-esc="session.meeting_id.pot_settlement_fund_id.display_name or 'Non versé'"/></td><td class="amount" style="font-weight: 700;"><span t-field="session.period_id.settled_amount"/></td></tr></tfoot>
                        </table>

                        <h3 class="subscription-report-section">Situation globale des membres</h3>
                        <table class="subscription-report-table">
                            <thead><tr><th>N°</th><th>Membre</th><th class="amount">Encaissé en séance</th><th class="amount">Reste dû</th><th>État</th></tr></thead>
                            <tbody>
                                <tr t-foreach="situations" t-as="situation"><td><span t-esc="situation.member_code or ''"/></td><td><span t-esc="situation.member_id.display_name"/></td><td class="amount"><span t-esc="situation.amount_paid_in_meeting" t-options="money"/></td><td class="amount"><span t-esc="situation.amount_due" t-options="money"/></td><td><span t-field="situation.payment_state"/></td></tr>
                                <!-- Anciennes réunions sans tableau de trésorerie : situation figée du cycle. -->
                                <tr t-if="not situations" t-foreach="session.snapshot_ids" t-as="line"><td><span t-field="line.member_code"/></td><td><span t-field="line.member_name"/></td><td class="amount"><span t-field="line.amount_paid"/></td><td class="amount"><span t-field="line.balance"/></td><td><span t-field="line.payment_state"/></td></tr>
                                <tr t-if="not situations and not session.snapshot_ids"><td colspan="5" class="subscription-report-empty">Aucun membre appelé dans cette réunion.</td></tr>
                            </tbody>
                            <tfoot><tr><td colspan="2" style="text-align: right; font-weight: 700;">Total</td><td class="amount" style="font-weight: 700;"><span t-esc="sum(situations.mapped('amount_paid_in_meeting'))" t-options="money"/></td><td class="amount" style="font-weight: 700;"><span t-esc="sum(situations.mapped('amount_due'))" t-options="money"/></td><td/></tr></tfoot>
                        </table>

                        <h3 class="subscription-report-section">Détail des recouvrements par membre</h3>
                        <t t-foreach="situations" t-as="situation">
                            <t t-set="member_payments" t-value="session.get_member_recovery_details(situation.member_id)"/>
                            <div style="margin: 0 0 10px; padding: 7px 9px; border: 1px solid #d9dde3; page-break-inside: avoid;">
                                <div style="font-weight: 700; color: #1f4e78; margin-bottom: 4px;"><span t-esc="situation.member_id.display_name"/> — encaissé en séance : <span t-esc="situation.amount_paid_in_meeting" t-options="money"/> · reste dû : <span t-esc="situation.amount_due" t-options="money"/></div>
                                <table class="subscription-report-table" t-if="member_payments"><thead><tr><th>Référence</th><th>Date</th><th>Mode</th><th>Détail</th><th class="amount">Montant</th></tr></thead><tbody><tr t-foreach="member_payments" t-as="payment"><td><span t-field="payment.name"/></td><td><span t-field="payment.payment_date"/></td><td><span t-field="payment.payment_method"/></td><td><span t-field="payment.payment_reference"/></td><td class="amount"><span t-field="payment.amount"/></td></tr></tbody></table>
                                <div t-if="not member_payments" class="subscription-report-empty">Aucun règlement validé pour ce membre durant cette réunion.</div>
                            </div>
                        </t>
                        <t t-if="session.closure_note">
                            <h3 class="subscription-report-section">Décision de clôture</h3>
                            <div class="subscription-report-note"><span t-field="session.closure_note"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
