<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_association_receipt_a5" model="report.paperformat">
        <field name="name">Reçu association A5</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <record id="action_report_payment_receipt" model="ir.actions.report">
        <field name="name">Reçu d'encaissement</field>
        <field name="model">association.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_association.report_payment_receipt</field>
        <field name="report_file">primetech_association.report_payment_receipt</field>
        <field name="paperformat_id" ref="paperformat_association_receipt_a5"/>
        <field name="binding_model_id" ref="model_association_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Reçu - %s' % (object.name or '')</field>
    </record>

    <record id="action_report_expense_receipt" model="ir.actions.report">
        <field name="name">Reçu de décaissement</field>
        <field name="model">association.expense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_association.report_expense_receipt</field>
        <field name="report_file">primetech_association.report_expense_receipt</field>
        <field name="paperformat_id" ref="paperformat_association_receipt_a5"/>
        <field name="binding_model_id" ref="model_association_expense"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Reçu décaissement - %s' % (object.name or '')</field>
    </record>

    <template id="report_payment_receipt">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><t t-set="primary" t-value="doc.company_id.primary_color or '#1f5fa8'"/><t t-set="secondary" t-value="doc.company_id.secondary_color or primary"/><div class="page" style="font-family:Arial,sans-serif;"><div style="height:128px;"/>
            <div t-att-style="'height:4px; background:%s; margin:0 0 14px;' % primary"/>
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin:0 2px 16px;"><div><div style="font-size:22px; font-weight:bold; color:#202a3a;">REÇU D'ENCAISSEMENT</div><div style="font-size:11px; color:#69758a; margin-top:4px;">Justificatif de paiement enregistré</div></div><div t-att-style="'color:%s; text-align:right; font-size:11px;' % primary"><strong style="font-size:14px;" t-esc="doc.name"/><br/>Date : <span t-field="doc.payment_date"/></div></div>
            <div style="border:1px solid #dbe2eb; border-radius:8px; overflow:hidden; background:#fff;"><div t-att-style="'padding:12px 18px; background:%s; color:#fff; font-size:11px; text-transform:uppercase; letter-spacing:.8px;' % primary">Informations du membre</div><div style="padding:14px 18px;"><div style="font-size:18px; font-weight:bold; color:#202a3a;" t-esc="doc.member_id.display_name"/><div t-if="doc.member_id.member_code" style="font-size:11px; color:#69758a; margin-top:3px;">N° membre : <span t-esc="doc.member_id.member_code"/></div></div>
                <table style="width:100%; border-collapse:collapse; font-size:12px;"><tbody><tr><td style="width:42%; padding:9px 18px; border-top:1px solid #e6ebf1; color:#667085;">Date de paiement</td><td style="padding:9px 18px; border-top:1px solid #e6ebf1;"><span t-field="doc.payment_date"/></td></tr><tr><td style="padding:9px 18px; border-top:1px solid #e6ebf1; color:#667085;">Mode de paiement</td><td style="padding:9px 18px; border-top:1px solid #e6ebf1;"><span t-field="doc.payment_method"/></td></tr><tr><td style="padding:9px 18px; border-top:1px solid #e6ebf1; color:#667085;">Compte de versement</td><td style="padding:9px 18px; border-top:1px solid #e6ebf1;"><span t-field="doc.receipt_account_id"/></td></tr><tr t-if="doc.payment_reference"><td style="padding:9px 18px; border-top:1px solid #e6ebf1; color:#667085;">Référence externe</td><td style="padding:9px 18px; border-top:1px solid #e6ebf1;"><span t-esc="doc.payment_reference"/></td></tr></tbody></table>
                <t t-if="doc.line_ids"><div t-att-style="'padding:12px 18px; background:%s; color:#fff; font-size:11px; text-transform:uppercase; letter-spacing:.8px;' % secondary">Cotisations réglées</div><table style="width:100%; border-collapse:collapse; font-size:11px;"><thead><tr style="background:#f5f7fa; color:#667085;"><th style="text-align:left; padding:8px 18px;">Cotisation</th><th style="text-align:right; padding:8px 10px;">Réglé</th><th style="text-align:right; padding:8px 18px;">Reste à régler</th></tr></thead><tbody><t t-foreach="doc.line_ids" t-as="line"><tr><td style="padding:8px 18px; border-top:1px solid #e6ebf1;"><span t-esc="line.subscription_id.display_name or line.subscription_line_id.subscription_id.display_name or 'Affectation de paiement'"/></td><td style="padding:8px 10px; border-top:1px solid #e6ebf1; text-align:right;"><span t-field="line.amount_paid" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td><td style="padding:8px 18px; border-top:1px solid #e6ebf1; text-align:right;"><span t-field="line.balance_after_payment" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr></t></tbody></table></t>
                <table t-att-style="'margin:16px 18px; border-collapse:separate; border-spacing:0; border-radius:7px; background:%s; color:#fff;' % primary" width="520"><tbody><tr><td style="padding:16px; font-size:11px; letter-spacing:.6px; vertical-align:middle;">MONTANT ENCAISSÉ</td><td style="padding:16px; text-align:right; font-size:22px; font-weight:bold; white-space:nowrap; vertical-align:middle;"><span t-field="doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr></tbody></table>
            </div>
            <table style="width:100%; margin-top:38px; border-collapse:separate; border-spacing:0; text-align:center; font-size:11px; color:#3b4658;"><tbody><tr><td style="width:38%; border-top:1px solid #8492a6; padding-top:8px;">Signature du membre</td><td style="width:24%;"/><td style="width:38%; border-top:1px solid #8492a6; padding-top:8px;">Signature du responsable</td></tr></tbody></table>
        </div></t></t></t>
    </template>

    <template id="report_expense_receipt">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><t t-set="primary" t-value="doc.company_id.primary_color or '#1f5fa8'"/><t t-set="secondary" t-value="doc.company_id.secondary_color or primary"/><div class="page" style="font-family:Arial,sans-serif;"><div style="height:128px;"/>
            <div t-att-style="'background:%s; color:#fff; padding:18px 22px; border-radius:10px 10px 0 0;' % primary"><div style="font-size:10px; letter-spacing:1.2px; text-transform:uppercase; opacity:.82;">Association</div><div style="font-size:24px; font-weight:bold; margin-top:3px;">REÇU DE DÉCAISSEMENT</div><div style="margin-top:6px; font-size:12px;">N° <strong t-esc="doc.name"/> — Émis le <span t-field="doc.expense_date"/></div></div>
            <div style="border:1px solid #dce3ed; border-top:0; border-radius:0 0 10px 10px; overflow:hidden;"><div style="padding:16px 22px; background:#fff;"><div style="font-size:10px; text-transform:uppercase; letter-spacing:1px; color:#69758a;">Bénéficiaire</div><div style="font-size:18px; font-weight:bold; margin-top:4px;" t-esc="doc.member_id.display_name or doc.beneficiary_name or '—'"/></div>
                <table style="width:100%; border-collapse:collapse; font-size:12px;"><tbody><tr><td style="padding:10px 22px; width:42%; border-top:1px solid #e5e9f0; color:#667085;">Objet</td><td style="padding:10px 22px; border-top:1px solid #e5e9f0;"><span t-field="doc.subject"/></td></tr><tr><td style="padding:10px 22px; border-top:1px solid #e5e9f0; color:#667085;">Mode de décaissement</td><td style="padding:10px 22px; border-top:1px solid #e5e9f0;"><span t-field="doc.payment_method"/></td></tr><tr><td style="padding:10px 22px; border-top:1px solid #e5e9f0; color:#667085;">Compte de trésorerie</td><td style="padding:10px 22px; border-top:1px solid #e5e9f0;"><span t-field="doc.fund_id"/></td></tr></tbody></table>
                <table t-att-style="'margin:18px 22px; border-collapse:separate; border-spacing:0; border-radius:8px; background:%s; color:#fff;' % secondary" width="512"><tbody><tr><td style="padding:16px; font-size:12px; vertical-align:middle;">MONTANT DÉCAISSÉ</td><td style="padding:16px; text-align:right; font-size:22px; font-weight:bold; white-space:nowrap; vertical-align:middle;"><span t-field="doc.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr></tbody></table>
            </div>
            <table style="width:100%; margin-top:44px; border-collapse:separate; border-spacing:0; text-align:center; font-size:11px; color:#3b4658;"><tbody><tr><td style="width:38%; border-top:1px solid #8492a6; padding-top:8px;">Signature du bénéficiaire</td><td style="width:24%;"/><td style="width:38%; border-top:1px solid #8492a6; padding-top:8px;">Signature du responsable</td></tr></tbody></table>
        </div></t></t></t>
    </template>
</odoo>
