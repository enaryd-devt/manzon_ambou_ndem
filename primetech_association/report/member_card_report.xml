<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- FORMAT PAPIER A6                                          -->
    <!-- ========================================================= -->

    <record
        id="paperformat_member_card_a6"
        model="report.paperformat">

        <field name="name">Carte membre A6</field>

        <field name="default" eval="False"/>

        <field name="format">custom</field>

        <field name="page_width">105</field>

        <field name="page_height">148</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">0</field>

        <field name="margin_bottom">0</field>

        <field name="margin_left">0</field>

        <field name="margin_right">0</field>

        <field name="header_line" eval="False"/>

        <field name="header_spacing">0</field>

        <field name="disable_shrinking" eval="True"/>

        <field name="dpi">96</field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION RAPPORT CARTE MEMBRE                               -->
    <!-- ========================================================= -->

    <record
        id="action_report_member_card"
        model="ir.actions.report">

        <field name="name">Carte de membre</field>

        <field name="model">association.card</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">primetech_association.report_member_card_document</field>

        <field name="report_file">primetech_association.report_member_card_document</field>

        <field
            name="paperformat_id"
            ref="paperformat_member_card_a6"/>

        <field
            name="binding_model_id"
            ref="model_association_card"/>

        <field name="binding_type">report</field>

        <field name="print_report_name">'Carte - %s' % (object.card_number or '')</field>

    </record>

</odoo>
