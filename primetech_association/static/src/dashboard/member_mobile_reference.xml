<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="primetech_association.AssociationDashboard" t-inherit-mode="extension" owl="1">
    <xpath expr="//section[contains(@class, 'member_portal')]/header[contains(@class, 'member_portal_head')]" position="after">
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active and state.memberPage === 'home'" t-att-class="'member_mobile_reference member_theme_' + (state.data.member_theme || 'system')">
        <section class="mmr_stats">
          <button t-on-click="() => this.openMemberPage('more')"><i class="fa fa-money"/><span>Solde de votre compte</span><b><t t-esc="formatAmount(state.data.member.account_balance || 0)"/> <em t-esc="state.data.currency.symbol"/></b><small>Compte personnel</small><strong>›</strong></button>
          <button t-on-click="() => this.openMemberPage('subscriptions')"><i class="fa fa-balance-scale"/><span>Ma situation financière</span><b class="danger"><t t-esc="formatAmount(state.data.member.financial_situation.total_due || 0)"/> <em t-esc="state.data.currency.symbol"/></b><small>Montant total dû</small><strong>›</strong></button>
          <button t-on-click="() => this.openMemberPage('subscriptions')"><i class="fa fa-calendar"/><span>Cotisations actives</span><b t-esc="state.data.member.subscriptions.length || 0"/><strong>›</strong></button>
          <button t-on-click="() => this.openMemberPage('more')"><i class="fa fa-gavel"/><span>Sanctions enregistrées</span><b class="danger" t-esc="state.data.member.penalty_count || 0"/><strong>›</strong></button>
        </section>
        <section class="mmr_panel mmr_meetings"><header><h2><i class="fa fa-calendar"/> Prochaines réunions</h2><button t-on-click="() => this.openMemberPage('meetings')">Voir tout</button></header><t t-foreach="state.data.upcoming_meetings || []" t-as="meeting" t-key="meeting.id"><button class="mmr_row" t-on-click="() => this.openMeeting(meeting.id)"><time><b t-esc="(meeting.date || '').slice(0, 2)"/><small t-esc="(meeting.date || '').slice(3, 5)"/></time><span><b t-esc="meeting.title"/><small><i class="fa fa-map-marker"/> Réunion de l'association</small></span><em>À venir</em><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.upcoming_meetings || []).length" class="mmr_empty">Aucune réunion à venir.</p></section>
        <section class="mmr_panel"><header><h2><i class="fa fa-file-text-o"/> Derniers rapports de recouvrement</h2><button t-on-click="() => this.openMemberPage('meetings')">Voir tout</button></header><t t-foreach="(state.data.shared_recovery_reports || []).slice(0, 2)" t-as="report" t-key="report.id"><button class="mmr_row" t-on-click="() => this.openMemberRecoveryReport(report.id)"><time><b t-esc="(report.date || '').slice(0, 2)"/><small t-esc="(report.date || '').slice(3, 5)"/></time><span><b t-esc="report.title"/><small t-esc="report.meeting || ''"/></span><em><i class="fa fa-eye"/> Aperçu</em><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.shared_recovery_reports || []).length" class="mmr_empty">Aucun rapport partagé.</p></section>
        <section class="mmr_panel"><header><h2><i class="fa fa-list-alt"/> Mes cotisations</h2><button t-on-click="() => this.openMemberPage('subscriptions')">Voir tout</button></header><t t-foreach="(state.data.member.subscriptions || []).slice(0, 3)" t-as="subscription" t-key="subscription.id"><button class="mmr_subscription" t-on-click="() => this.openMemberSubscription(subscription.id)"><b t-esc="subscription.name"/><span>Total dû <strong><t t-esc="formatAmount(subscription.total_due)"/> <t t-esc="state.data.currency.symbol"/></strong></span><span>Payé <strong><t t-esc="formatAmount(subscription.paid)"/> <t t-esc="state.data.currency.symbol"/></strong></span><span>Reste <strong class="blue"><t t-esc="formatAmount(subscription.balance)"/> <t t-esc="state.data.currency.symbol"/></strong></span><em t-esc="subscription.state"/><i class="fa fa-angle-right"/></button></t></section>
        <section class="mmr_bottom_panels"><section class="mmr_panel"><header><h2><i class="fa fa-history"/> Historique de vos paiements</h2><button t-on-click="() => this.openMemberPage('payments')">Voir tout</button></header><t t-foreach="(state.data.member.payments || []).slice(0, 2)" t-as="payment" t-key="payment.id"><button class="mmr_payment" t-on-click="() => this.openMemberPayment(payment.id)"><time><b t-esc="(payment.date || '').slice(0, 2)"/><small t-esc="(payment.date || '').slice(3, 5)"/></time><span><strong><t t-esc="formatAmount(payment.amount)"/> <t t-esc="state.data.currency.symbol"/></strong><small t-esc="payment.name"/></span><em t-esc="payment.state"/></button></t></section><section class="mmr_panel"><header><h2><i class="fa fa-bank"/> Solde de trésorerie</h2></header><t t-foreach="(state.data.treasury_accounts || []).slice(0, 2)" t-as="fund" t-key="fund.id"><button class="mmr_fund" t-on-click="() => this.openMemberTreasury(fund.id)"><span t-esc="fund.name"/><b><t t-esc="formatAmount(fund.balance)"/> <t t-esc="state.data.currency.symbol"/></b></button></t></section></section>
      </section>
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active and state.memberPage === 'subscriptions'" t-att-class="'member_mobile_page member_theme_' + (state.data.member_theme || 'system')">
        <header><button t-on-click="() => this.openMemberPage('home')"><i class="fa fa-arrow-left"/></button><div><small>Espace membre</small><h1>Mes cotisations</h1></div></header>
        <section class="mmp_summary"><span>Montant total dû</span><strong><t t-esc="formatAmount(state.data.member.financial_situation.total_due || 0)"/> <em t-esc="state.data.currency.symbol"/></strong><small><t t-esc="state.data.member.subscriptions.length || 0"/> cotisation(s) suivie(s)</small></section>
        <section class="mmp_list"><t t-foreach="state.data.member.subscriptions || []" t-as="subscription" t-key="subscription.id"><button class="mmp_item" t-on-click="() => this.openMemberSubscription(subscription.id)"><i class="fa fa-calendar"/><span><b t-esc="subscription.name"/><small t-esc="subscription.cycle || 'Cycle en cours'"/></span><strong><t t-esc="formatAmount(subscription.balance)"/> <em t-esc="state.data.currency.symbol"/></strong><em t-esc="subscription.state"/><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.member.subscriptions || []).length" class="mmr_empty">Aucune cotisation disponible.</p></section>
      </section>
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active and state.memberPage === 'payments'" t-att-class="'member_mobile_page member_theme_' + (state.data.member_theme || 'system')">
        <header><button t-on-click="() => this.openMemberPage('home')"><i class="fa fa-arrow-left"/></button><div><small>Espace membre</small><h1>Mes paiements</h1></div></header>
        <section class="mmp_summary green"><span>Total de vos paiements</span><strong><t t-esc="formatAmount(state.data.member.payments_total || 0)"/> <em t-esc="state.data.currency.symbol"/></strong><small><t t-esc="state.data.member.payment_count || 0"/> paiement(s) enregistré(s)</small></section>
        <section class="mmp_list"><t t-foreach="state.data.member.payments || []" t-as="payment" t-key="payment.id"><button class="mmp_item" t-on-click="() => this.openMemberPayment(payment.id)"><time><b t-esc="(payment.date || '').slice(0,2)"/><small t-esc="(payment.date || '').slice(3,5)"/></time><span><b t-esc="payment.name"/><small t-esc="payment.date"/></span><strong class="green"><t t-esc="formatAmount(payment.amount)"/> <em t-esc="state.data.currency.symbol"/></strong><em t-esc="payment.state"/><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.member.payments || []).length" class="mmr_empty">Aucun paiement enregistré.</p></section>
      </section>
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active and state.memberPage === 'meetings'" t-att-class="'member_mobile_page member_theme_' + (state.data.member_theme || 'system')">
        <header><button t-on-click="() => this.openMemberPage('home')"><i class="fa fa-arrow-left"/></button><div><small>Espace membre</small><h1>Réunions et documents</h1></div></header>
        <h2 class="mmp_title">Prochaines réunions</h2><section class="mmp_list"><t t-foreach="state.data.upcoming_meetings || []" t-as="meeting" t-key="meeting.id"><button class="mmp_item" t-on-click="() => this.openMeeting(meeting.id)"><time><b t-esc="(meeting.date || '').slice(0,2)"/><small t-esc="(meeting.date || '').slice(3,5)"/></time><span><b t-esc="meeting.title"/><small t-esc="meeting.date"/></span><em>À venir</em><i class="fa fa-angle-right"/></button></t></section>
        <h2 class="mmp_title">Procès-verbaux</h2><section class="mmp_list"><t t-foreach="state.data.shared_minutes || []" t-as="minute" t-key="minute.id"><button class="mmp_item" t-on-click="() => this.openMemberMinutes(minute.id)"><i class="fa fa-file-text-o"/><span><b t-esc="minute.title"/><small t-esc="minute.date"/></span><em>Aperçu</em><i class="fa fa-angle-right"/></button></t></section>
        <h2 class="mmp_title">Rapports de recouvrement</h2><section class="mmp_list"><t t-foreach="state.data.shared_recovery_reports || []" t-as="report" t-key="report.id"><button class="mmp_item" t-on-click="() => this.openMemberRecoveryReport(report.id)"><i class="fa fa-line-chart"/><span><b t-esc="report.title"/><small t-esc="report.meeting || report.date"/></span><em>Aperçu</em><i class="fa fa-angle-right"/></button></t></section>
      </section>
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active and state.memberPage === 'more'" t-att-class="'member_mobile_page member_theme_' + (state.data.member_theme || 'system')">
        <header><button t-on-click="() => this.openMemberPage('home')"><i class="fa fa-arrow-left"/></button><div><small>Espace membre</small><h1>Mon espace</h1></div></header>
        <h2 class="mmp_title">Trésorerie de l'association</h2><section class="mmp_list"><t t-foreach="state.data.treasury_accounts || []" t-as="fund" t-key="fund.id"><button class="mmp_item" t-on-click="() => this.openMemberTreasury(fund.id)"><i class="fa fa-bank"/><span><b t-esc="fund.name"/><small>Compte de trésorerie</small></span><strong><t t-esc="formatAmount(fund.balance)"/> <em t-esc="state.data.currency.symbol"/></strong><i class="fa fa-angle-right"/></button></t></section>
        <h2 class="mmp_title">Mes sanctions</h2><section class="mmp_list"><t t-foreach="state.data.member.sanctions || []" t-as="sanction" t-key="sanction.id"><button class="mmp_item" t-on-click="() => this.openMemberPenalty(sanction.id)"><i class="fa fa-gavel"/><span><b t-esc="sanction.name"/><small t-esc="sanction.state"/></span><strong><t t-esc="formatAmount(sanction.amount || 0)"/> <em t-esc="state.data.currency.symbol"/></strong><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.member.sanctions || []).length" class="mmr_empty">Aucune sanction enregistrée.</p></section>
      </section>
    </xpath>
  </t>
</templates>
