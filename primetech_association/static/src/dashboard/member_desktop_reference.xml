<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="primetech_association.AssociationDashboard" t-inherit-mode="extension" owl="1">
    <xpath expr="//section[contains(@class, 'member_portal')]/header[contains(@class, 'member_portal_head')]/div[contains(@class, 'member_portal_company')]" position="after">
      <button class="member_desktop_user_button" title="Menu utilisateur" t-on-click="toggleMemberMenu">
        <img t-att-src="'/web/image/res.users/' + state.data.user_id + '/avatar_128?unique=' + (state.data.avatar_version || '')" alt="Photo de profil"/>
        <span><b t-esc="state.data.user_name || 'Membre'"/><small>Mon compte</small></span><i class="fa fa-angle-down"/>
      </button>
    </xpath>
    <xpath expr="//section[contains(@class, 'member_portal')]/header[contains(@class, 'member_portal_head')]" position="after">
      <section t-if="state.data.member &amp;&amp; state.data.member.is_active" class="member_desktop_reference">
        <section class="member_desktop_kpis">
          <button class="member_desktop_kpi account" t-on-click="() => this.openMemberPage('more')"><i class="fa fa-wallet"/><span><b>Solde de votre compte</b><strong><t t-esc="formatAmount(state.data.member.account_balance || 0)"/> <em t-esc="state.data.currency.symbol"/></strong><small>Compte personnel</small></span><i class="fa fa-angle-right"/></button>
          <button class="member_desktop_kpi financial" t-on-click="() => this.openMemberPage('financial')"><i class="fa fa-bar-chart"/><span><b>Ma situation financière</b><strong><t t-esc="formatAmount(state.data.member.financial_situation.total_due || 0)"/> <em t-esc="state.data.currency.symbol"/></strong><small>Montant total dû</small></span><i class="fa fa-angle-right"/></button>
          <button class="member_desktop_kpi subscriptions" t-on-click="() => this.openMemberPage('subscriptions')"><i class="fa fa-list-alt"/><span><b>Cotisations actives</b><strong t-esc="state.data.member.subscriptions.length || 0"/></span><i class="fa fa-angle-right"/></button>
          <button class="member_desktop_kpi sanctions" t-on-click="() => this.openMemberPage('more')"><i class="fa fa-gavel"/><span><b>Sanctions enregistrées</b><strong t-esc="state.data.member.penalty_count || 0"/></span><i class="fa fa-angle-right"/></button>
        </section>
        <section class="member_desktop_layout">
          <div class="member_desktop_left">
            <article class="member_desktop_panel member_desktop_subscriptions"><header><h2><i class="fa fa-database"/> Mes cotisations</h2><button t-on-click="() => this.openMemberPage('subscriptions')">Voir tout</button></header><div class="member_desktop_table"><div class="member_desktop_table_head"><span>Cotisation</span><span>Total dû</span><span>Payé</span><span>Reste</span><span>Statut</span></div><t t-foreach="(state.data.member.subscriptions || []).slice(0, 5)" t-as="subscription" t-key="subscription.id"><button t-on-click="() => this.openMemberSubscription(subscription.id)"><b t-esc="subscription.name"/><strong><t t-esc="formatAmount(subscription.total_due)"/> <em t-esc="state.data.currency.symbol"/></strong><strong><t t-esc="formatAmount(subscription.paid)"/> <em t-esc="state.data.currency.symbol"/></strong><strong><t t-esc="formatAmount(subscription.balance)"/> <em t-esc="state.data.currency.symbol"/></strong><span class="member_desktop_status" t-esc="subscription.state"/></button></t><p t-if="!(state.data.member.subscriptions || []).length" class="member_desktop_empty">Aucune cotisation suivie.</p></div></article>
            <article class="member_desktop_panel member_desktop_payments"><header><h2><i class="fa fa-history"/> Historique de vos paiements</h2><button t-on-click="() => this.openMemberPage('payments')">Voir tout</button></header><div class="member_desktop_table"><div class="member_desktop_table_head payment"><span>Date</span><span>Montant</span><span>Statut</span></div><t t-foreach="(state.data.member.payments || []).slice(0, 5)" t-as="payment" t-key="payment.id"><button class="payment" t-on-click="() => this.openMemberPayment(payment.id)"><span t-esc="formatMemberDate(payment.date)"/><strong><t t-esc="formatAmount(payment.amount)"/> <em t-esc="state.data.currency.symbol"/></strong><span class="member_desktop_status confirmed" t-esc="payment.state"/></button></t><p t-if="!(state.data.member.payments || []).length" class="member_desktop_empty">Aucun paiement enregistré.</p></div></article>
            <article class="member_desktop_panel member_desktop_reports"><header><h2><i class="fa fa-file-text-o"/> Derniers rapports de recouvrement</h2><button t-on-click="() => this.openMemberPage('meetings')">Voir tout</button></header><div class="member_desktop_report_list"><t t-foreach="(state.data.shared_recovery_reports || []).slice(0, 3)" t-as="report" t-key="report.id"><button t-on-click="() => this.openMemberRecoveryReport(report.id)"><time><b t-esc="(report.date || '').slice(0, 2)"/><small t-esc="(report.date || '').slice(3, 5)"/></time><span><b t-esc="report.title"/><small t-esc="report.meeting || ''"/></span><em><i class="fa fa-eye"/> Aperçu</em><i class="fa fa-angle-right"/></button></t><p t-if="!(state.data.shared_recovery_reports || []).length" class="member_desktop_empty">Aucun rapport partagé.</p></div></article>
          </div>
          <aside class="member_desktop_right">
            <article class="member_desktop_panel member_desktop_treasury"><header><h2><i class="fa fa-bank"/> Solde de trésorerie</h2></header><div class="member_desktop_treasury_total"><small>Total</small><strong><t t-esc="formatAmount(state.data.treasury_total || 0)"/> <em t-esc="state.data.currency.symbol"/></strong></div><div class="member_desktop_funds"><t t-foreach="state.data.treasury_accounts || []" t-as="fund" t-key="fund.id"><button t-on-click="() => this.openMemberTreasury(fund)"><span t-esc="fund.name"/><strong><t t-esc="formatAmount(fund.balance || 0)"/> <em t-esc="state.data.currency.symbol"/></strong></button></t><p t-if="!(state.data.treasury_accounts || []).length" class="member_desktop_empty">Aucun compte actif.</p></div></article>
            <article class="member_desktop_panel member_desktop_meetings"><header><h2><i class="fa fa-calendar"/> Prochaines réunions</h2><button t-on-click="() => this.openMemberPage('meetings')">Voir tout</button></header><div class="member_desktop_meeting_list"><t t-foreach="(state.data.upcoming_meetings || []).slice(0, 3)" t-as="meeting" t-key="meeting.id"><button t-on-click="() => this.openMeeting(meeting.id)"><i class="fa fa-calendar-o"/><span><b t-esc="meeting.title"/><small t-esc="meeting.date"/></span><i class="fa fa-angle-right"/></button></t><div t-if="!(state.data.upcoming_meetings || []).length" class="member_desktop_empty member_desktop_no_meeting"><i class="fa fa-calendar"/><span>Aucune réunion à venir.</span></div></div></article>
          </aside>
        </section>
      </section>
      <t t-portal="'body'"><t t-if="state.memberMenuOpen || state.memberMenuClosing"><div class="member_desktop_menu_backdrop" t-on-click="closeMemberMenu"/><div t-att-class="'member_desktop_account_menu' + (state.memberMenuClosing ? ' is-closing' : '')" t-on-click.stop=""><button t-on-click="openMemberProfile"><i class="fa fa-user"/><span>Mon profil</span></button><button t-on-click="changeMemberPassword"><i class="fa fa-key"/><span>Modifier le mot de passe</span></button><button t-on-click="toggleMemberTheme"><i class="fa fa-paint-brush"/><span>Thème</span><i class="fa fa-angle-right"/></button><div t-if="state.memberThemeOpen" class="member_desktop_theme_picker"><button t-on-click="() => this.setMemberTheme('system')"><b class="theme-system"/> Système</button><button t-on-click="() => this.setMemberTheme('ocean')"><b class="theme-ocean"/> Bleu océan</button><button t-on-click="() => this.setMemberTheme('emerald')"><b class="theme-emerald"/> Vert émeraude</button><button t-on-click="() => this.setMemberTheme('violet')"><b class="theme-violet"/> Violet</button><button t-on-click="() => this.setMemberTheme('sunset')"><b class="theme-sunset"/> Orange</button><button t-on-click="() => this.setMemberTheme('black')"><b class="theme-black"/> Noir</button></div><button class="danger" t-on-click="logoutMember"><i class="fa fa-sign-out"/><span>Se déconnecter</span></button></div></t></t>
    </xpath>
  </t>
</templates>
